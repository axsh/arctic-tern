{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-record-payload.schema.json",
  "title": "AgentRecordPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_type",
    "agent",
    "task_summary",
    "raw_notes",
    "changed_paths",
    "flags"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "source_type": {
      "type": "string",
      "const": "coding_agent"
    },
    "agent": {
      "type": "string",
      "enum": ["codex", "claude-code", "antigravity", "cursor", "unknown"]
    },
    "task_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "raw_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "client_request_id": {
      "type": "string",
      "minLength": 1
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture_impact": { "type": "boolean" },
        "memory_related": { "type": "boolean" },
        "prompt_related": { "type": "boolean" },
        "agent_behavior_related": { "type": "boolean" },
        "design_pattern": { "type": "boolean" },
        "convention": { "type": "boolean" },
        "lesson_learned": { "type": "boolean" },
        "preference": { "type": "boolean" },
        "requires_immediate_action": { "type": "boolean" }
      }
    }
  }
}
